{
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/cdn-proxy/(.*)", "destination": "https://cdn.springwave.io.vn/$1" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/explore", "destination": "/explore.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/hostActivity", "destination": "/hostActivity.html" },
    { "source": "/complete-profile", "destination": "/complete-profile.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/community", "destination": "/community.html" },
    { "source": "/register-host", "destination": "/register-host.html" },
    { "source": "/org-dashboard", "destination": "/org-dashboard.html" },
    { "source": "/org-profile", "destination": "/org-profile.html" },
    { "source": "/verify-email", "destination": "/verify-email.html" },
    { "source": "/quiz", "destination": "/quiz.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/admin-host", "destination": "/admin-host.html" },
    { "source": "/my-tickets", "destination": "/my-tickets.html" },
    { "source": "/kiosk", "destination": "/kiosk.html" },
    { "source": "/policy", "destination": "/policy.html" },
    { "source": "/privacy", "destination": "/policy.html" },
    { "source": "/terms", "destination": "/policy.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/components/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/locales/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
